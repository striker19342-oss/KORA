# Frontend: use the deployed Render URL in Netlify, with no trailing slash.
VITE_API_BASE_URL=http://localhost:8000
VITE_MIDNIGHT_NETWORK=preview

# Backend: configure these in Render (never expose them as VITE_* values).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler/DB?ssl=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,https://YOUR-NETLIFY-SITE.netlify.app
MIDNIGHT_CONTRACT_ADDRESS=
VITE_KORA_CONTRACT_ADDRESS=
